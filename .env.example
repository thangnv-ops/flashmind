# ──────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
#   cp .env.example .env.local
# ──────────────────────────────────────────────

# Public URL of this app — used as OAuth redirect base
VITE_APP_URL=PLACEHOLDER_APP_URL

# Supabase — Project Settings → API
VITE_SUPABASE_URL=PLACEHOLDER_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=PLACEHOLDER_SUPABASE_ANON_KEY

# Supabase personal access token — used by: npm run migrate
# Get one at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# MinIO — image uploads (optional: falls back to Supabase Storage if not set)
VITE_MINIO_ENDPOINT=PLACEHOLDER_MINIO_ENDPOINT
VITE_MINIO_ACCESS_KEY=PLACEHOLDER_MINIO_ACCESS_KEY
VITE_MINIO_SECRET_KEY=PLACEHOLDER_MINIO_SECRET_KEY
VITE_MINIO_BUCKET=PLACEHOLDER_MINIO_BUCKET
VITE_MINIO_REGION=PLACEHOLDER_MINIO_REGION
