# ──────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
#   cp .env.example .env.local
# ──────────────────────────────────────────────

# Supabase — Project Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Supabase personal access token — used by: npm run migrate
# Get one at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=<personal-access-token>

# MinIO — image uploads (optional: falls back to Supabase Storage if not set)
VITE_MINIO_ENDPOINT=https://minio.example.com
VITE_MINIO_ACCESS_KEY=<access-key>
VITE_MINIO_SECRET_KEY=<secret-key>
VITE_MINIO_BUCKET=flashmind
VITE_MINIO_REGION=us-east-1
