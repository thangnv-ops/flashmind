:8080 {
	root * /srv
	file_server

	# SPA fallback — route all non-file requests to index.html
	try_files {path} /index.html

	# Cache static assets
	@static {
		path *.js *.css *.png *.jpg *.jpeg *.gif *.webp *.svg *.ico *.woff *.woff2
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	encode gzip
}
